{
  "name": "@obinexusltd/obix-core-func",
  "version": "0.2.0",
  "description": "OBIX functional adapter — a callable-function interface (createFunctional) over a canonical @obinexusltd/obix-core-data definition. State stays owned by obix-core-data; this package binds actions and preserves their argument/return types.",
  "license": "MIT",
  "author": "OBINexus <okpalan@protonmail.com>",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@obinexusltd/obix-core-data": "^0.4.0"
  },
  "files": [
    "dist",
    "src",
    "__tests__",
    "docs",
    "README.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"__tests__/*.test.mjs\""
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexusmk2/obix-core-func.git",
    "directory": "core/obix-core-func"
  }
}
